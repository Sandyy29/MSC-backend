            "post": {
                "tags": [
                    "User Management"
                ],
                "summary": "Create a new Manager or Employee",
                "description": "- HR can create MANAGER users.\n- Manager can create EMPLOYEE users.\n- Employee cannot create users.",
                "operationId": "262eb5ca1fdea354023c0a8870442c1e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "username",
                                    "email",
                                    "role"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Karthik Manager"
                                    },
                                    "username": {
                                        "type": "string",
                                        "example": "karthik"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "karthik@company.com"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "MANAGER",
                                            "EMPLOYEE"
                                        ]
                                    },
                                    "departmentRole": {
                                        "type": "string",
                                        "example": "Development"
                                    },
                                    "managerId": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "branch": {
                                        "type": "string",
                                        "example": "Madurai"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
