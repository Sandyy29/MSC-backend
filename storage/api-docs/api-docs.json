        "/tasks/{id}": {
            "put": {
                "tags": [
                    "Task Management"
                ],
                "summary": "Update task progress and status",
                "description": "Employee updates ONLY their assigned task's status and progress.",
                "operationId": "2a0a8c212f84263f9a249469557b2539",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
