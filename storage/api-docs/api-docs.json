                                                        "name": {
                                                            "type": "string",
                                                            "example": "Employee Name"
                                                        },
                                                        "username": {
                                                            "type": "string",
                                                            "example": "employee1"
                                                        },
                                                        "email": {
                                                            "type": "string",
                                                            "example": "employee@example.com"
                                                        },
                                                        "department_role": {
                                                            "type": "string",
                                                            "example": "Software Developer"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "statistics": {
                                                    "properties": {
                                                        "total_tasks": {
                                                            "type": "integer",
                                                            "example": 5
                                                        },
                                                        "pending_tasks": {
                                                            "type": "integer",
                                                            "example": 2
                                                        },
                                                        "in_progress_tasks": {
                                                            "type": "integer",
                                                            "example": 2
                                                        },
                                                        "completed_tasks": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "overdue_tasks": {
                                                            "type": "integer",
                                                            "example": 0
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Unauthorized access"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
